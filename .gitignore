# ================================================================
#  LẠC — Unity .gitignore
#  Quy tắc: chỉ commit thứ CON NGƯỜI tạo ra. Mọi thứ Unity tự sinh
#  lại được từ Assets/ + Packages/ + ProjectSettings/ đều bị loại.
# ================================================================

# --- Unity tự sinh ---
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
/Assets/StreamingAssets/aa.meta
/Assets/StreamingAssets/aa/*

# --- IDE / solution (Unity tự sinh lại) ---
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
.vs/
.idea/
/.vscode/*
!/.vscode/extensions.json
!/.vscode/settings.json

# --- Build artifacts ---
sysinfo.txt
*.apk
*.aab
*.unitypackage
*.app
crashlytics-build.properties

# --- Claude Code / AI (giữ lại phần dùng chung) ---
/.claude/*
!/.claude/settings.json
!/.claude/commands/
!/.claude/skills/
.claude/settings.local.json

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- Riêng dự án ---
/Recordings/
/Telemetry/*.csv
!/Telemetry/.gitkeep
