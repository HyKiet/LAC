{
    "files.exclude": {
        "**/.DS_Store": true,
        "**/.git": true,
        "**/.vs": true,
        "**/.gitmodules": true,
        "**/.vsconfig": true,
        "**/*.booproj": true,
        "**/*.pidb": true,
        "**/*.suo": true,
        "**/*.user": true,
        "**/*.userprefs": true,
        "**/*.unityproj": true,
        "**/*.dll": true,
        "**/*.exe": true,
        "**/*.pdf": true,
        "**/*.mid": true,
        "**/*.midi": true,
        "**/*.wav": true,
        "**/*.gif": true,
        "**/*.ico": true,
        "**/*.jpg": true,
        "**/*.jpeg": true,
        "**/*.png": true,
        "**/*.psd": true,
        "**/*.tga": true,
        "**/*.tif": true,
        "**/*.tiff": true,
        "**/*.3ds": true,
        "**/*.3DS": true,
        "**/*.fbx": true,
        "**/*.FBX": true,
        "**/*.lxo": true,
        "**/*.LXO": true,
        "**/*.ma": true,
        "**/*.MA": true,
        "**/*.obj": true,
        "**/*.OBJ": true,
        "**/*.asset": true,
        "**/*.cubemap": true,
        "**/*.flare": true,
        "**/*.mat": true,
        "**/*.meta": true,
        "**/*.prefab": true,
        "**/*.unity": true,
        "build/": true,
        "Build/": true,
        "Library/": true,
        "library/": true,
        "obj/": true,
        "Obj/": true,
        "Logs/": true,
        "logs/": true,
        "ProjectSettings/": true,
        "UserSettings/": true,
        "temp/": true,
        "Temp/": true
    },
    "files.associations": {
        "*.asset": "yaml",
        "*.meta": "yaml",
        "*.prefab": "yaml",
        "*.unity": "yaml"
    },
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.patterns": {
        "*.sln": "*.csproj",
        "*.slnx": "*.csproj"
    },
    "dotnet.defaultSolution": "LAC.slnx",
    "_comment_todo": "Todo Tree doc docs/TASKS.md va cac file .cs -> hien cay task o sidebar",
    "todo-tree.general.tags": [
        "[ ]",
        "[x]",
        "TODO",
        "FIXME",
        "BUG",
        "HACK"
    ],
    "todo-tree.regex.regex": "(//|#|<!--|;|/\\*|^|^[ \\t]*(-|\\d+.))\\s*($TAGS)",
    "todo-tree.filtering.includeGlobs": [
        "**/docs/TASKS.md",
        "**/Assets/_LAC/**/*.cs"
    ],
    "todo-tree.filtering.excludeGlobs": [
        "**/Library/**",
        "**/Temp/**",
        "**/node_modules/**"
    ],
    "todo-tree.tree.showCountsInTree": true,
    "todo-tree.tree.groupedByTag": true,
    "todo-tree.tree.expanded": true,
    "todo-tree.highlights.customHighlight": {
        "[ ]": {
            "icon": "issue-opened",
            "iconColour": "#f0a020",
            "foreground": "#f0a020",
            "type": "tag"
        },
        "[x]": {
            "icon": "issue-closed",
            "iconColour": "#3fb950",
            "foreground": "#3fb950",
            "type": "tag",
            "hideFromTree": false
        },
        "TODO": {
            "icon": "note",
            "iconColour": "#58a6ff",
            "type": "tag"
        },
        "FIXME": {
            "icon": "tools",
            "iconColour": "#f0a020",
            "type": "tag"
        },
        "BUG": {
            "icon": "bug",
            "iconColour": "#f85149",
            "type": "tag"
        },
        "HACK": {
            "icon": "flame",
            "iconColour": "#db6d28",
            "type": "tag"
        }
    },
    "_comment_md": "Alt+C de tick/bo tick checkbox trong TASKS.md",
    "markdown.preview.breaks": true,
    "markdown-preview-enhanced.previewTheme": "github-dark.css",
    "markdown-preview-enhanced.enableTypographer": true,
    "[markdown]": {
        "editor.wordWrap": "on",
        "editor.quickSuggestions": {
            "other": true
        },
        "editor.defaultFormatter": "yzhang.markdown-all-in-one"
    }
}